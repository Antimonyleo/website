{
  "name": "hao-liu-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "add-pub": "node scripts/add-publication.mjs",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "images": "node scripts/build-image-variants.mjs",
    "maintenance": "node scripts/maintenance-report.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "test": "npm run check && npm run build && node scripts/build-image-variants.mjs --check && npm run validate && npm run verify:preview",
    "test:preview": "npm run build && npm run validate && npm run verify:preview",
    "test:template": "npm run check && npm run build",
    "validate": "node scripts/validate-build.mjs",
    "verify:preview": "node scripts/verify-preview.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.0"
  }
}
