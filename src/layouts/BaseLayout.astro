---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { SITE } from "../config";
import { getPublicPerson } from "../lib/person";
import { withBase } from "../lib/urls";
import "../styles/global.css";
// Imported rather than referenced by path so Vite emits hashed, immutable
// filenames and rewrites them for whatever `base` the site is deployed under.
import archivoFont from "../assets/fonts/archivo.woff2";
import serifFont from "../assets/fonts/source-serif-4.woff2";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
  pageType?: "WebPage" | "ProfilePage" | "CollectionPage";
  itemList?: Array<{ name: string; url: string }>;
  noIndex?: boolean;
  canonicalPath?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  pageClass = "",
  pageType = "WebPage",
  itemList = [],
  noIndex = false,
  canonicalPath,
} = Astro.props;
const personData = await getPublicPerson();
const canonical = canonicalPath
  ? new URL(withBase(canonicalPath), Astro.site ?? Astro.url)
  : Astro.site
    ? new URL(Astro.url.pathname, Astro.site)
    : Astro.url;
const socialImageUrl = new URL(withBase("og-card.jpg"), Astro.site ?? Astro.url);
const homeUrl = new URL(withBase(), Astro.site ?? Astro.url);

const personSchema = {
  "@type": "Person",
  name: personData.name,
  honorificSuffix: personData.degree,
  url: homeUrl.href,
  jobTitle: personData.role,
  affiliation: personData.organizations.map((name) => ({
    "@type": "ResearchOrganization",
    name,
  })),
  sameAs: [personData.orcid, personData.scholar, SITE.github],
  knowsAbout: [
    "Nucleic acid nanotechnology",
    "DNA origami",
    "Molecular self-assembly",
    "Coarse-grained molecular modeling",
    "Inverse design",
  ],
};

const pageSchema = {
  "@context": "https://schema.org",
  "@type": pageType,
  name: title,
  description,
  url: canonical.href,
  isPartOf: {
    "@type": "WebSite",
    name: `${personData.name} Research`,
    url: homeUrl.href,
  },
  ...(pageType === "ProfilePage" ? { mainEntity: personSchema } : {}),
  ...(pageType === "CollectionPage" && itemList.length
    ? {
        mainEntity: {
          "@type": "ItemList",
          numberOfItems: itemList.length,
          itemListElement: itemList.map((item, index) => ({
            "@type": "ListItem",
            position: index + 1,
            name: item.name,
            url: item.url,
          })),
        },
      }
    : {}),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#f8faf8" />
    {/* Both faces are used above the fold on every page; the italic is not. */}
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={archivoFont} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageUrl} />
    <meta
      property="og:image:alt"
      content={`${personData.name}, nucleic acid nanotechnology researcher — computational design and experimental nanotechnology.`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  </head>
  <body class:list={["site-v2", pageClass]}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <script>
      /*
        Content settles in as it is scrolled to. Progressive enhancement in
        both directions: the hiding styles are scoped to `.js-reveal`, which
        only this script adds, so with JavaScript disabled — or when the reader
        prefers reduced motion — every element keeps its ordinary static
        styles and nothing is ever left invisible.
      */
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

      if (!reduced.matches) {
        /*
          Repeating items and the headings that introduce them. Deliberately
          not whole sections: on most pages the section element is also the
          shell, so fading a section would fade a full screen of content at
          once, which reads as the page loading slowly rather than as content
          arriving.
        */
        const targets = document.querySelectorAll<HTMLElement>(
          [
            ".section-heading",
            ".home-paper",
            ".publication-row",
            ".research-scale-row",
            ".news-card",
            ".timeline > li",
          ].join(", "),
        );

        if (targets.length && "IntersectionObserver" in window) {
          document.documentElement.classList.add("js-reveal");

          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                // One-shot: scrolling back up must not replay it.
                entry.target.classList.add("is-revealed");
                observer.unobserve(entry.target);
              }
            },
            // Fires slightly before the element reaches the viewport edge, so
            // the transition is finishing rather than starting as it arrives.
            { rootMargin: "0px 0px -8% 0px", threshold: 0.01 },
          );

          for (const [index, target] of targets.entries()) {
            target.classList.add("reveal");
            /*
              Items in the same group arrive in sequence rather than together.
              Capped at four steps so a long publication list never leaves the
              reader waiting on a queue.
            */
            target.style.transitionDelay = `${Math.min(index, 4) * 70}ms`;
            observer.observe(target);
          }

          /*
            Anything already on screen at load reveals immediately, and the
            hero keeps no delay — the first paint should not look staged.
          */
          requestAnimationFrame(() => {
            for (const target of targets) {
              const box = target.getBoundingClientRect();
              if (box.top < window.innerHeight) {
                target.style.transitionDelay = "0ms";
                target.classList.add("is-revealed");
                observer.unobserve(target);
              }
            }
          });
        }
      }
    </script>
  </body>
</html>
