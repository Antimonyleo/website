{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Publication entry",
  "description": "Editor entry; derived DOI links, status and profile membership are normalized by the site. npm test validates relationships.",
  "definitions": {
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "basis",
        "sourceUrl"
      ],
      "properties": {
        "role": {
          "enum": [
            "equal-contribution",
            "corresponding-author"
          ],
          "description": "Renders as † (equal contribution) or * (corresponding author)."
        },
        "basis": {
          "enum": [
            "explicit-equal-contribution-note",
            "explicit-authorship-note",
            "explicit-corresponding-author-note"
          ],
          "description": "What public evidence supports this mark."
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "description": "Public source that states the role. Usually the paper's own DOI."
        }
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Exactly as printed in the public byline."
        },
        "memberId": {
          "const": "hao-liu",
          "description": "Set only on Hao Liu; drives the bold name."
        },
        "contributions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/contribution"
          }
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "authors",
        "year",
        "venue",
        "kind",
        "doi",
        "summary",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Stable slug. Never change or reuse — research.ts references it."
        },
        "title": {
          "type": "string"
        },
        "shortTitle": {
          "type": "string",
          "description": "Optional plain-language title for Research; Home and Publications use the full article title."
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/author"
          },
          "description": "Public author order, exactly."
        },
        "memberIds": {
          "type": "array",
          "items": {
            "const": "hao-liu"
          }
        },
        "year": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2100
        },
        "venue": {
          "type": "string"
        },
        "volumePages": {
          "type": "string",
          "minLength": 1,
          "description": "Required for article and commentary; must be absent for preprint."
        },
        "kind": {
          "enum": [
            "article",
            "commentary",
            "preprint"
          ]
        },
        "recordStatus": {
          "enum": [
            "peer-reviewed",
            "editorial",
            "preprint-not-peer-reviewed",
            "accepted"
          ],
          "description": "Derived from kind: article/peer-reviewed, commentary/editorial, preprint/preprint-not-peer-reviewed; a preprint with acceptedIn has status accepted."
        },
        "acceptedIn": {
          "type": "string",
          "minLength": 1,
          "description": "Confirmed accepting journal while the linked record is still a preprint. Keep the preprint venue, year and DOI until the final journal record is available."
        },
        "manuscriptStatus": {
          "enum": [
            "Submitted",
            "In revision"
          ],
          "description": "Preprints only."
        },
        "doi": {
          "type": "string",
          "description": "DOI or full DOI URL."
        },
        "url": {
          "type": "string",
          "pattern": "^https://doi\\.org/10\\.",
          "description": "Must be exactly https://doi.org/{doi}."
        },
        "featured": {
          "type": "boolean",
          "description": "True puts it in the homepage selected list; then selectedOrder is required."
        },
        "selectedOrder": {
          "type": "integer",
          "minimum": 1,
          "description": "Optional homepage position."
        },
        "researchStoryId": {
          "enum": [
            "rna-strand-displacement",
            "programmable-assembly"
          ],
          "description": "Adds the 'Related research' link."
        },
        "summary": {
          "type": "string",
          "minLength": 20,
          "description": "One sentence, your own words, saying what this paper established."
        },
        "significance": {
          "type": "string"
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relatedItems": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relation",
              "title",
              "year",
              "venue",
              "volumePages",
              "doi",
              "url",
              "counted"
            ],
            "properties": {
              "relation": {
                "const": "author-correction"
              },
              "title": {
                "type": "string"
              },
              "year": {
                "type": "integer"
              },
              "venue": {
                "type": "string"
              },
              "volumePages": {
                "type": "string"
              },
              "doi": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "counted": {
                "const": false
              }
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceCheckedAt"
          ],
          "properties": {
            "canonicalSource": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "url"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            },
            "sourceCheckedAt": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "ISO date you last checked this record against the publisher."
            }
          }
        },
        "fileId": {
          "type": "string",
          "format": "uuid",
          "description": "Generated by Pages CMS; filenames supply stable record IDs."
        },
        "order": {
          "type": "integer"
        },
        "figures": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/figure"
          }
        },
        "image": {
          "type": "object",
          "properties": {
            "src": {
              "type": "string"
            },
            "alt": {
              "type": "string"
            }
          },
          "required": [
            "src",
            "alt"
          ]
        }
      }
    },
    "figure": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "credit": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "src",
        "alt",
        "caption",
        "credit"
      ]
    }
  },
  "$ref": "#/definitions/publication"
}
