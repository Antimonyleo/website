---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResearchScaleRow from "../../components/ResearchScaleRow.astro";
import { researchScaleGroups, researchPage, researchFigures } from "../../data/research";
import { getPublicPerson } from "../../lib/person";
import { imageAttributes } from "../../lib/images";
import { withBase } from "../../lib/urls";

const person = await getPublicPerson();
const publications = await getCollection("publications");
const publicationsById = new Map(publications.map((publication) => [publication.id, publication]));
const publication = (id: string) => {
  const record = publicationsById.get(id);
  if (!record) throw new Error(`Missing publication record: ${id}`);
  return record;
};
const foundationPapers = (researchPage.foundations.publicationIds ?? []).map(publication);
const collaborations = researchScaleGroups.flatMap((group) => group.collaborations ?? []);
const { directions, methods } = researchPage;
const overviewFigure = directions.figureId ? researchFigures[directions.figureId] : undefined;
if (directions.figureId && !overviewFigure) throw new Error(`Missing overview figure: ${directions.figureId}`);
const overviewImage = overviewFigure ? await imageAttributes(overviewFigure.src) : undefined;
---

<BaseLayout
  title={`Research — ${person.name}`}
  description={`Research by ${person.name} in inverse design, molecular modeling, and programmable nucleic acid assembly.`}
  pageClass="research-page"
>
  <header class="page-intro shell research-intro">
    <h1>{researchPage.intro.title}</h1>
  </header>

  <section class="shell research-section research-philosophy" id="research-directions" aria-labelledby="philosophy-title">
    <h2 class="research-section-title" id="philosophy-title">{directions.title}</h2>
    {directions.paragraphs.map((paragraph, index) => <p class:list={[index === 0 && "research-lede"]}>{paragraph}</p>)}
    {overviewFigure && overviewImage && <figure class="research-overview-figure" data-research-figure={overviewFigure.id} data-figure-kind={overviewFigure.kind}>
      <a class="research-overview-frame" href={withBase(overviewFigure.src)} target="_blank" rel="noopener noreferrer" aria-label="Open the full-size schematic (opens in a new tab)">
        <img {...overviewImage} sizes="(max-width: 720px) 92vw, 640px" alt={overviewFigure.alt} loading="eager" decoding="async" />
      </a>
      <figcaption>{overviewFigure.caption}</figcaption>
    </figure>}
  </section>

  <section class="shell research-section research-program" id="programmable-assembly" data-research-chapter="programmable-assembly" aria-labelledby="methods-title">
    <h2 class="research-section-title" id="methods-title">{methods.title}</h2>
    {methods.paragraphs.map((paragraph) => <p class="research-methods-text">{paragraph}</p>)}
    <ol class="research-scale-list">
      {researchScaleGroups.map((group) => (
        <ResearchScaleRow group={group} publicationsById={publicationsById} />
      ))}
    </ol>
  </section>

  <div class="research-background shell">
    <details class="research-note research-foundations" id="molecular-programming-foundations" data-research-chapter="rna-strand-displacement" aria-labelledby="foundations-title">
      <summary><h2 class="research-section-title" id="foundations-title">{researchPage.foundations.title}</h2></summary>
      <div class="research-note-body">
        {researchPage.foundations.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <div class="research-foundation-links">
          {foundationPapers.map((paper) => (
            <a data-collaborative-work={paper.id} href={paper.data.url} target="_blank" rel="noopener noreferrer">
              {paper.data.venue} · {paper.data.year}<span class="sr-only"> — {paper.data.title} (opens in a new tab)</span>
            </a>
          ))}
        </div>
        {collaborations.length > 0 && <p>
          Related collaborations:{" "}
          {collaborations.map((reference, index) => (
            <>
              {index > 0 && (index === collaborations.length - 1 ? " and " : ", ")}
              <a data-collaborative-work={reference.publicationId} href={publication(reference.publicationId).data.url} target="_blank" rel="noopener noreferrer">
                {reference.label}<span class="sr-only"> (opens in a new tab)</span>
              </a>
            </>
          ))}.
        </p>}
      </div>
    </details>
  </div>
</BaseLayout>
