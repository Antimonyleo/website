---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PublicationRow from "../../components/PublicationRow.astro";
import SocialLinks from "../../components/SocialLinks.astro";
import { getPublicPerson } from "../../lib/person";
import { withBase } from "../../lib/urls";

const person = await getPublicPerson();
const publications = (await getCollection("publications")).sort(
  (a, b) =>
    b.data.year - a.data.year ||
    (a.data.order ?? 9999) - (b.data.order ?? 9999) || a.id.localeCompare(b.id),
);
const years = [...new Set(publications.map((publication) => publication.data.year))];
---

<BaseLayout
  title={`Publications — ${person.name}`}
  description={`Journal articles and preprints by ${person.name} in nucleic acid nanotechnology, self-assembly, molecular programming, and nanomaterials.`}
  pageType="CollectionPage"
  pageClass="publications-page"
  itemList={publications.map((publication) => ({
    name: publication.data.title,
    url: publication.data.url,
  }))}
>
  <header class="page-intro publication-intro shell">
    <h1>Publications</h1>
    <div class="publication-tools" aria-label="Publication links">
      <p>{publications.length} publications and preprints</p>
      <div>
        <a class="text-link" href={person.scholar} target="_blank" rel="noopener noreferrer">
          Google Scholar<span class="sr-only"> (opens in a new tab)</span>
        </a>
        {
          publications.length > 0 && (
            <a
              class="bibtex-link"
              href={withBase("publications/hao-liu-publications.bib")}
              download="hao-liu-publications.bib"
            >
              Download BibTeX
            </a>
          )
        }
      </div>
    </div>
  </header>

  {
    publications.length === 0 ? (
      <section class="empty-state shell" role="status">
        <h2>Publication records are temporarily unavailable.</h2>
        <p>Please use Google Scholar for the current public record.</p>
        <SocialLinks />
      </section>
    ) : (
      <section class="section shell publication-record" aria-label="Publications, newest first">
        {years.map((year) => (
          <section class="publication-year-group" aria-labelledby={`year-${year}`} data-publication-year={year}>
            <h2 id={`year-${year}`}>{year}</h2>
            <div class="publication-rows">
              {publications.filter((publication) => publication.data.year === year)
                .map((publication) => <PublicationRow publication={publication} />)}
            </div>
          </section>
        ))}
      </section>
    )
  }

  <script>
    async function copyText(text: string) {
      await navigator.clipboard.writeText(text);
    }

    if (window.isSecureContext) {
      document.querySelectorAll<HTMLButtonElement>("[data-copy-citation]").forEach(
        (button) => {
          button.hidden = false;
          button.addEventListener("click", async () => {
            const citation = button.dataset.copyCitation;
            const status = button.parentElement?.querySelector<HTMLElement>(
              ".copy-citation-status",
            );

            if (!citation) return;

            try {
              await copyText(citation);
              button.textContent = "Copied";
              if (status) status.textContent = "Citation copied to clipboard.";
            } catch {
              button.textContent = "Copy failed";
              if (status) {
                status.textContent =
                  "Citation could not be copied. Use the BibTeX download instead.";
              }
            }

            window.setTimeout(() => {
              button.textContent = "Copy citation";
            }, 1800);
          });
        },
      );
    }
  </script>
</BaseLayout>
