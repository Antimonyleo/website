---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EmailLink from "../../components/EmailLink.astro";
import PageIntro from "../../components/PageIntro.astro";
import SocialLinks from "../../components/SocialLinks.astro";
import { displayName, getPublicPerson } from "../../lib/person";

import { SITE } from "../../config";
const person = await getPublicPerson();
const encodedEmail = Buffer.from(person.email, "utf8").toString("base64");
---

<BaseLayout
  title={`Contact — ${person.name}`}
  description={SITE.contactDescription}
  pageClass="contact-page"
>
  <PageIntro title="Contact" />

  <section class="section shell contact-content" aria-labelledby="contact-email-title">
    <div class="contact-details">
      <h2 id="contact-email-title">{displayName(person)}</h2>
      <p class="contact-role">{person.role}</p>
      <p class="contact-affiliation">{person.organizations.join(" · ")}</p>
      <p class="contact-location">{person.location}</p>

      <div class="contact-email-actions">
        <EmailLink class="contact-email" />
        <button type="button" class="copy-email" data-email={encodedEmail} hidden>Copy email</button>
      </div>
      <p class="copy-email-status" role="status" aria-live="polite" aria-atomic="true"></p>
      <input class="copy-email-fallback" type="text" aria-label="Email address — select and copy" readonly hidden />
      <noscript><p class="email-fallback">Enable JavaScript to use the email link.</p></noscript>
      <SocialLinks />
    </div>

  </section>
</BaseLayout>

<script>
  const button = document.querySelector<HTMLButtonElement>(".copy-email");
  const status = document.querySelector<HTMLElement>(".copy-email-status");
  const fallback = document.querySelector<HTMLInputElement>(".copy-email-fallback");

  if (button && status && fallback && button.dataset.email) {
    const address = atob(button.dataset.email);
    delete button.dataset.email;
    button.hidden = false;

    button.addEventListener("click", async () => {
      button.disabled = true;
      status.textContent = "Copying…";
      try {
        await navigator.clipboard.writeText(address);
        fallback.hidden = true;
        status.textContent = "Email address copied.";
      } catch {
        fallback.value = address;
        fallback.hidden = false;
        status.textContent = "Automatic copying is unavailable. Select and copy the address below.";
        fallback.focus();
        fallback.select();
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
