---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsCard from "../../components/NewsCard.astro";
import PageIntro from "../../components/PageIntro.astro";
import { getNewsItems } from "../../lib/news";
import { getPublicPerson } from "../../lib/person";
import { withBase } from "../../lib/urls";

import { SITE } from "../../config";
const person = await getPublicPerson();
const newsItems = await getNewsItems();
---

<BaseLayout
  title={`News — ${person.name}`}
  description={SITE.newsDescription}
  pageType="CollectionPage"
  itemList={newsItems.map(({ post }) => ({
    name: post.data.title,
    url: new URL(withBase(`news/${post.id}/`), Astro.site ?? Astro.url).href,
  }))}
>
  <PageIntro
    title="News"
  />

  <section class="news-tools shell" aria-label="News feed links">
    <p>{newsItems.length} update{newsItems.length === 1 ? "" : "s"}</p>
    <div>
      <a class="rss-link" href={withBase("news/rss.xml")}>
        RSS feed
      </a>
    </div>
  </section>

  <section class="section shell news-index" aria-labelledby="news-list-title">
    <h2 class="sr-only" id="news-list-title">News, newest first</h2>
    <div class="news-card-grid">
      {
        newsItems.map((item) => (
          <NewsCard post={item.post} publication={item.publication} />
        ))
      }
    </div>
  </section>
</BaseLayout>
