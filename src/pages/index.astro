---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { srcSetFor } from "../lib/images";
import { displayName, getPublicPerson, primaryOrganization } from "../lib/person";
import { withBase } from "../lib/urls";

const heroImage = "images/publications/polycubes-2025.webp";
const portraitImage = "images/hao-liu-boston.webp";
const person = await getPublicPerson();
const publications = await getCollection("publications");
const publicationsById = new Map(
  publications.map((publication) => [publication.id, publication]),
);

/*
  Editorial copy only. Which papers appear here, and in what order, is decided
  by `featured` and `selectedOrder` in publications.json — as
  publications.schema.json documents — so changing the selection does not mean
  editing markup.
*/
const paperLeads: Record<string, { role: string; lead: string }> = {
  "pyrochlore-2024": {
    role: "First author",
    lead:
      "Can interaction rules designed on a computer survive the wet lab? Modeling led to a DNA-origami pyrochlore lattice verified by scattering and microscopy.",
  },
  "tetrahedral-lattices-2026": {
    role: "First and co-corresponding author",
    lead:
      "Can one nanoscale scaffold choose among several open crystals? Reprogramming only four sticky ends selects cubic diamond, hexagonal diamond, or ice 0.",
  },
  "polycubes-2025": {
    role: "Co-first and co-corresponding author",
    lead:
      "How few components are enough to build a chosen 3D object? Inverse design programs DNA-origami cubes while screening out competing assemblies.",
  },
};

const selectedPapers = publications
  .filter((item) => item.data.featured)
  .sort((a, b) => (a.data.selectedOrder ?? 0) - (b.data.selectedOrder ?? 0))
  .map((publication) => {
    const details = paperLeads[publication.id];
    if (!details) {
      throw new Error(
        `Publication ${publication.id} is featured but has no homepage lead copy in paperLeads.`,
      );
    }
    return { publication, id: publication.id, ...details };
  });

if (selectedPapers.length === 0) {
  throw new Error("No featured publications found");
}
---

<BaseLayout pageClass="home-page" pageType="ProfilePage">
  <section class="home-hero shell" aria-labelledby="home-title">
    <figure class="home-hero-figure" data-home-hero-paper="polycubes-2025">
      <img
        src={withBase(heroImage)}
        srcset={srcSetFor(heroImage)}
        sizes="(min-width: 1240px) 767px, (min-width: 721px) 62vw, 100vw"
        alt="A designed DNA-origami polycube shown beside an electron-microscopy image of the experimentally assembled structure."
        width="900"
        height="600"
        decoding="async"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>
        <span>Design and experiment · DNA polycubes</span>
        <a
          href={publicationsById.get("polycubes-2025")!.data.url}
          target="_blank"
          rel="noopener noreferrer"
        >Read the paper ↗</a>
      </figcaption>
    </figure>

    <div class="home-hero-identity">
      <div class="home-hero-person">
        <div class="home-hero-portrait">
          <img
            src={withBase(portraitImage)}
            srcset={srcSetFor(portraitImage)}
            sizes="(max-width: 720px) 144px, 156px"
            alt="Hao Liu at a boat railing on Boston Harbor, with the city skyline behind him."
            width="1800"
            height="1350"
            decoding="async"
            loading="eager"
          />
        </div>
        <div>
          <p class="eyebrow">Nucleic acid nanotechnology</p>
          <h1 id="home-title">{displayName(person)}</h1>
        </div>
      </div>

      <p class="home-role">
        {person.role} · {primaryOrganization(person)}
      </p>
      {/*
        The first-person biography from src/content/people/hao-liu.md, which
        was written and approved but rendered nowhere. It replaces the generic
        tagline rather than sitting alongside it — two self-descriptions in the
        same block is what made earlier versions feel repetitive.
      */}
      <div class="home-hero-proposition" data-home-proposition data-home-bio>
        {person.bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="home-identity-links">
        <SocialLinks />
        <a class="text-link" href={withBase("contact/")}>Contact</a>
      </div>
    </div>
  </section>

  <section class="home-research shell" aria-labelledby="home-research-title">
    <header class="home-research-heading">
      <div>
        <p class="eyebrow">Research</p>
        <h2 id="home-research-title">Selected papers</h2>
      </div>
      <a class="section-link" href={withBase("research/")}>Research overview</a>
    </header>

    <div class="home-paper-grid">
      {
        selectedPapers.map(({ publication, role, lead }, index) => (
          <article
            class="home-paper"
            data-home-primary-publication={publication.id}
          >
            <div class="home-paper-meta">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <span>{publication.data.year}</span>
              <span>{role}</span>
            </div>
            <h3>
              <a
                href={publication.data.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {publication.data.title}<span class="external-arrow" aria-hidden="true">↗</span>
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </h3>
            <p>{lead}</p>
            <p class="home-paper-venue">
              {publication.data.venue}
              {publication.data.recordStatus === "preprint-not-peer-reviewed"
                ? " · Preprint, not peer reviewed"
                : " · Peer reviewed"}
            </p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
