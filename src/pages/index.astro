---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import EmailLink from "../components/EmailLink.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { researchScaleGroups } from "../data/research";
import { imageAttributes } from "../lib/images";
import { SITE } from "../config";
import { getPublicPerson, primaryOrganization } from "../lib/person";
import { withBase } from "../lib/urls";

const person = await getPublicPerson();
const experience = await getEntry("experience", "hao-liu");
const career = [
  ...(experience?.data.appointments ?? []).slice(0, 1),
  ...(experience?.data.education ?? []).map((item) => ({ ...item, title: item.degree })),
];
const publications = await getCollection("publications");
const researchByPaper = new Map(researchScaleGroups.flatMap((group) =>
  group.publications.map((reference) => [reference.publicationId, { ...reference, groupId: group.id }] as const),
));
// Homepage selection and summaries come from the editable publication records.
const selectedPapers = publications
  .filter((item) => item.data.featured)
  .sort((a, b) => (a.data.selectedOrder ?? 9999) - (b.data.selectedOrder ?? 9999) || b.data.year - a.data.year || (a.data.order ?? 9999) - (b.data.order ?? 9999) || a.id.localeCompare(b.id));
const methods = experience?.data.showCapabilities ? experience.data.capabilities : [];
---

<BaseLayout pageClass="home-page" pageType="ProfilePage">
  <section class="home-hero shell" aria-labelledby="home-title">
    <div class:list={["home-hero-identity", !person.portrait && "without-portrait"]}>
      {person.portrait && <div class="home-hero-portrait">
        <img
          {...await imageAttributes(person.portrait.src)}
          sizes="(max-width: 640px) 96px, (max-width: 900px) 176px, 232px"
          alt={person.portrait.alt}
          decoding="async"
          loading="eager"
          fetchpriority="high"
        />
      </div>}
      <div class="home-hero-person">
        <h1 id="home-title">{person.name}<span class="home-degree">, {person.degree}</span></h1>
        <p class="home-role">
          {person.role} · {primaryOrganization(person)}
        </p>
      </div>
      <div class="home-hero-proposition" data-home-proposition data-home-bio>
        {person.bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="home-identity-links">
        <EmailLink />
        <SocialLinks />
      </div>
    </div>
  </section>

  {selectedPapers.length > 0 && <section class="home-research shell" aria-labelledby="home-research-title">
    <header class="home-research-heading">
      <div>
        <h2 id="home-research-title">{SITE.selectedPapersTitle}</h2>
      </div>
      <a class="section-link" href={withBase("publications/")}>All publications</a>
    </header>

    <ol class="home-paper-list">
      {
        selectedPapers.map((publication, index) => {
          const research = researchByPaper.get(publication.id);
          const researchUrl = research ? withBase(`research/#${research.groupId}`) : publication.data.url;
          return (
          <li class="home-paper home-paper-compact" data-home-primary-publication={publication.id}>
            <div class="home-paper-text">
              <h3>
                <a href={researchUrl}>{publication.data.title}</a>
              </h3>
              <p class="home-paper-summary">{publication.data.summary}</p>
            </div>
            <div class="home-paper-context">
              <p class="home-paper-meta paper-meta">
                {publication.data.acceptedIn ? <>
                  <span class="home-paper-venue is-accepted">{publication.data.acceptedIn} · Accepted</span>
                  <a href={publication.data.url} aria-label={`Preprint of ${publication.data.title}`}>Preprint</a>
                </> : <>
                  <a class="home-paper-venue" href={publication.data.url} aria-label={`${publication.data.title} — ${publication.data.venue}, ${publication.data.year}`}>
                    {publication.data.venue} · {publication.data.year}
                  </a>
                  {publication.data.kind === "preprint" && <span>Preprint</span>}
                </>}
              </p>
            </div>
          </li>
          );
        })
      }
    </ol>
  </section>}

  {methods.length > 0 && <section class="home-methods shell" aria-labelledby="home-methods-title">
    <header class="home-research-heading">
      <h2 id="home-methods-title">Expertise</h2>
    </header>
    <div class="expertise-grid">
      {methods.map((group) => (
        <div class="expertise-group">
          <h3>{group.title}</h3>
          <ul>
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>}

  {career.length > 0 && <section class="home-experience shell" aria-labelledby="home-experience-title">
    <header class="home-research-heading">
      <h2 id="home-experience-title">Experience</h2>
      <a class="section-link" href={withBase("experience/")}>Full experience</a>
    </header>
    <ol class="career-summary">
      {career.map((item) => (
        <li>
          <span>{item.period}</span>
          <div><h3>{item.title}</h3><p>{item.institution}</p></div>
        </li>
      ))}
    </ol>
  </section>}
</BaseLayout>
