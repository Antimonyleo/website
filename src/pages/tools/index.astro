---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import { tools } from "../../data/tools";
import { getPublicPerson } from "../../lib/person";
import { withBase } from "../../lib/urls";

const person = await getPublicPerson();

/** Site-relative paths get the base prefix; everything else is already absolute. */
const linkFor = (href: string) =>
  href.startsWith("http") ? href : withBase(href);
const isExternal = (href: string) => href.startsWith("http");
---

<BaseLayout
  title={`Tools and data — ${person.name}`}
  description={`Software, structure designs, and data released by ${person.name}.`}
  pageClass="tools-page"
>
  <PageIntro
    eyebrow="Tools and data"
    title="Things you can use"
    description="Software and designs released alongside the published work, so the results can be rebuilt rather than taken on trust."
  />

  <section class="section shell" aria-labelledby="tools-title">
    <h2 class="sr-only" id="tools-title">Released software and data</h2>

    <ol class="tool-list">
      {
        tools.map((tool) => (
          <li class="tool-entry" data-tool={tool.id}>
            <div class="tool-heading">
              <h3>
                <a
                  href={linkFor(tool.href)}
                  {...(isExternal(tool.href)
                    ? { target: "_blank", rel: "noopener noreferrer" }
                    : {})}
                >
                  {tool.name}
                  {isExternal(tool.href) && (
                    <>
                      <span class="external-arrow" aria-hidden="true">
                        ↗
                      </span>
                      <span class="sr-only"> (opens in a new tab)</span>
                    </>
                  )}
                </a>
              </h3>
              <p class="tool-meta">
                {tool.meta.map((item) => (
                  <span>{item}</span>
                ))}
              </p>
            </div>

            <div class="tool-body">
              <p class="tool-summary">{tool.summary}</p>
              {tool.parts && (
                <ul class="tool-parts">
                  {tool.parts.map((part) => (
                    <li>{part}</li>
                  ))}
                </ul>
              )}
              <p class="tool-role">{tool.role}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
