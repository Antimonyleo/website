---
import EmailLink from "./EmailLink.astro";
import SocialLinks from "./SocialLinks.astro";
import { getPublicPerson, primaryOrganization } from "../lib/person";

const person = await getPublicPerson();
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <p>© {new Date().getFullYear()} {person.name} · {primaryOrganization(person)}</p>
    <div class="footer-links">
      <EmailLink />
      <SocialLinks />
    </div>
  </div>
</footer>
