---
import type { CollectionEntry } from "astro:content";
import type { ResearchFigureData } from "../data/research";
import { imageAttributes } from "../lib/images";
import { withBase } from "../lib/urls";

interface Props {
  figure: ResearchFigureData;
  sourcePublication?: CollectionEntry<"publications">;
  loading?: "eager" | "lazy";
  /** Caption stays for screen readers and print; the surrounding text explains the figure on screen. */
  quietCaption?: boolean;
}

const {
  figure,
  sourcePublication,
  loading = "lazy",
  quietCaption = false,
} = Astro.props;
const attributes = await imageAttributes(figure.src);

if (figure.source && !sourcePublication) {
  throw new Error(
    `Research figure "${figure.id}" is missing publication metadata for "${figure.source.publicationId}".`,
  );
}

const sourceLabel =
  figure.source && sourcePublication
    ? [
        `${sourcePublication.data.venue} ${sourcePublication.data.year}`,
        figure.source.locator,
        figure.source.showDoi ? `doi:${sourcePublication.data.doi}` : undefined,
      ]
        .filter(Boolean)
        .join(" · ")
    : undefined;
---

<figure
  class="research-figure"
  data-research-figure={figure.id}
  data-figure-kind={figure.kind}
>
  <a
    class="research-figure-frame"
    href={withBase(figure.src)}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Open full-size image: ${figure.alt} (opens in a new tab)`}
  >
    <img
      {...attributes}
      sizes="(max-width: 700px) 90vw, 420px"
      alt={figure.alt}
      loading={loading}
      decoding="async"
    />
  </a>
  <figcaption class:list={[quietCaption && "research-figure-quiet-caption"]}>
    <div class="research-figure-notes">
      <div class="research-figure-caption">
        <span>
          {figure.captionLabel && <strong>{figure.captionLabel}</strong>}
          {figure.captionLabel && " "}
          {figure.caption}
        </span>
        {figure.credit && <span>{figure.credit}</span>}
        {
          figure.source && sourcePublication && sourceLabel && (
            <a data-figure-source href={sourcePublication.data.url} target="_blank" rel="noopener noreferrer">
              {sourceLabel} ↗
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          )
        }
      </div>
    </div>
  </figcaption>
</figure>
