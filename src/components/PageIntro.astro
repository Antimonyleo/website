---
interface Props {
  title: string;
  description?: string;
  date?: string;
}

const { title, description, date } = Astro.props;
---

<header class="page-intro shell">
  <h1>{title}</h1>
  {date && <p class="page-date">{date}</p>}
  {description && <p class="page-intro-description">{description}</p>}
</header>
