---
import type { CollectionEntry } from "astro:content";
import {
  researchFigures,
  type ResearchFigureData,
  type ResearchScaleGroup,
} from "../data/research";
import ResearchFigure from "./ResearchFigure.astro";
import { withBase } from "../lib/urls";

interface Props {
  group: ResearchScaleGroup;
  publicationsById: Map<string, CollectionEntry<"publications">>;
}

const { group, publicationsById } = Astro.props;

const publication = (id: string) => {
  const record = publicationsById.get(id);
  if (!record) {
    throw new Error(`Missing publication record: ${id}`);
  }
  return record;
};

const sourcePublication = (figure: ResearchFigureData) =>
  figure.source ? publication(figure.source.publicationId) : undefined;

const groupFigures = (group.figureIds ?? []).map((id) => researchFigures[id]);
const studies = group.publications.map((reference) => ({
  reference,
  record: publication(reference.publicationId),
  figures: groupFigures.filter((figure) => figure.source?.publicationId === reference.publicationId),
}));
const unassignedFigures = groupFigures.filter((figure) =>
  !studies.some((study) => study.figures.includes(figure)),
);
---

<li id={group.id} class="research-scale-row">
  {studies.map(({ reference, record, figures }) => (
    <article class:list={["research-study", figures.length === 0 && "without-figure"]} data-assembly-work={reference.publicationId}>
      <div class="research-study-copy">
        <h3>{record.data.shortTitle || record.data.title}</h3>
        <p class="research-study-description">{record.data.significance || record.data.summary}</p>
        <p class="research-paper-meta paper-meta">
          {record.data.acceptedIn ? <>
            <span class="is-accepted">{record.data.acceptedIn} · Accepted</span>
            <a href={record.data.url} target="_blank" rel="noopener noreferrer">Preprint<span class="sr-only"> of {record.data.title} (opens in a new tab)</span></a>
          </> : <>
            <a href={record.data.url} target="_blank" rel="noopener noreferrer">{record.data.venue} · {record.data.year}<span class="sr-only"> — {record.data.title} (opens in a new tab)</span></a>
            {record.data.kind === "preprint" && <span>Preprint</span>}
          </>}
        </p>
      </div>
      {figures.length > 0 && <div class="research-study-figures">
        {figures.map((figure) => (
          <ResearchFigure figure={figure} sourcePublication={record} quietCaption />
        ))}
      </div>}
    </article>
  ))}

  {unassignedFigures.length > 0 && <div class="research-additional-figures">
    {unassignedFigures.map((figure) => (
      <ResearchFigure figure={figure} sourcePublication={sourcePublication(figure)} quietCaption />
    ))}
  </div>}

  {group.story && <p class="research-story-hook" id={group.story.id}>
    <a href={withBase(`research/${group.story.id}/`)}>
      {group.story.description}
      <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14m-6-6 6 6-6 6" />
      </svg>
    </a>
  </p>}
</li>
