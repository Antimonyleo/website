---
interface StructuredAuthor {
  given?: string;
  family?: string;
  name?: string;
  literal?: string;
  memberId?: string;
  contributions?: Array<{
    role: "equal-contribution" | "corresponding-author";
    basis: string;
    sourceUrl: string;
  }>;
}

interface Props {
  authors: string | StructuredAuthor[];
}

const { authors } = Astro.props;
const structuredAuthors = Array.isArray(authors) ? authors : null;

function authorName(author: StructuredAuthor) {
  if (author.name) return author.name;
  if (author.literal) return author.literal;
  return [author.given, author.family].filter(Boolean).join(" ");
}

function isHao(author: StructuredAuthor) {
  return author.memberId === "hao-liu";
}

const contributionRoles = structuredAuthors
  ? new Set(
      structuredAuthors.flatMap((author) =>
        (author.contributions ?? []).map((contribution) => contribution.role),
      ),
    )
  : new Set<string>();
function contributionMark(author: StructuredAuthor) {
  const roles = new Set(
    (author.contributions ?? []).map((contribution) => contribution.role),
  );
  return `${roles.has("equal-contribution") ? "†" : ""}${roles.has("corresponding-author") ? "*" : ""}`;
}

function contributionDescription(author: StructuredAuthor) {
  return (author.contributions ?? [])
    .map((contribution) =>
      contribution.role === "equal-contribution"
        ? "equal contribution"
        : "corresponding author",
    )
    .join(" and ");
}
---

<>
  <span class="author-list">
    {
      structuredAuthors
        ? structuredAuthors.map((author, index) => {
            const mark = contributionMark(author);
            const name = isHao(author) ? (
              <strong>{authorName(author)}</strong>
            ) : (
              authorName(author)
            );
            return (
              <>
                {index > 0 &&
                  (index === structuredAuthors.length - 1 ? ", and " : ", ")}
                {mark ? (
                  <span
                    data-contribution-author={authorName(author)}
                    data-contribution-roles={(author.contributions ?? [])
                      .map((contribution) => contribution.role)
                      .join(" ")}
                  >
                    {name}
                    <sup aria-hidden="true">{mark}</sup>
                    <span class="sr-only">
                      {` (${contributionDescription(author)})`}
                    </span>
                  </span>
                ) : (
                  name
                )}
              </>
            );
          })
        : authors
    }
  </span>
  {
    contributionRoles.size > 0 && (
      <>
        <br />
        <span class="publication-contribution" data-authorship-legend>
          {contributionRoles.has("equal-contribution") && "† Equal contribution"}
          {contributionRoles.has("equal-contribution") &&
            contributionRoles.has("corresponding-author") &&
            " · "}
          {contributionRoles.has("corresponding-author") && "* Corresponding author"}
        </span>
      </>
    )
  }
</>
