{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.framework.id": "astro",
  "frontMatter.framework.startCommand": "npm run dev",
  "frontMatter.content.pageFolders": [
    {
      "title": "News",
      "path": "[[workspace]]/src/content/news",
      "excludeSubdir": true,
      "previewPath": "website/news",
      "contentTypes": [
        "news"
      ]
    },
    {
      "title": "People",
      "path": "[[workspace]]/src/content/people",
      "excludeSubdir": true,
      "previewPath": "website",
      "contentTypes": [
        "person"
      ]
    },
    {
      "title": "Experience",
      "path": "[[workspace]]/src/content/experience",
      "excludeSubdir": true,
      "previewPath": "website/experience",
      "contentTypes": [
        "experience"
      ]
    }
  ],
  "frontMatter.content.sorting": [
    {
      "id": "PublishedDesc",
      "title": "Published (newest first)",
      "name": "date",
      "order": "desc",
      "type": "date"
    }
  ],
  "frontMatter.content.defaultSorting": "PublishedDesc",
  "frontMatter.content.hideFm": true,
  "frontMatter.content.hideFmMessage": "Use the metadata form to edit these fields.",
  "frontMatter.content.wysiwyg": true,
  "frontMatter.content.publicFolder": "public",
  "frontMatter.contentHealth.enabled": false,
  "frontMatter.dashboard.content.card.fields.description": "summary",
  "frontMatter.dashboard.content.card.fields.state": false,
  "frontMatter.dashboard.content.cardTags": "",
  "frontMatter.preview.host": "http://127.0.0.1:4321",
  "frontMatter.preview.trailingSlash": true,
  "frontMatter.file.preserveCasing": false,
  "frontMatter.file.slugSeparator": "-",
  "frontMatter.git.enabled": false,
  "frontMatter.copilot.enabled": false,
  "frontMatter.media.supportedMimeTypes": [
    "image/webp",
    "image/png",
    "image/jpeg",
    "image/avif",
    "image/tiff"
  ],
  "frontMatter.data.files": [],
  "frontMatter.custom.scripts": [
    {
      "id": "run-full-release-gate",
      "title": "Run full release gate (npm test)",
      "script": "./.frontmatter/config/custom/scripts/run-test.sh",
      "command": "bash",
      "type": "content",
      "bulk": false,
      "output": "editor",
      "outputType": "text"
    },
    {
      "id": "check-research-source",
      "title": "Check research.json (fast)",
      "script": "./.frontmatter/config/custom/scripts/check-research.sh",
      "command": "bash",
      "type": "content",
      "bulk": false,
      "output": "notification",
      "outputType": "text"
    },
    {
      "id": "build-image-variants",
      "title": "Generate responsive image variants",
      "script": "./.frontmatter/config/custom/scripts/build-images.sh",
      "command": "bash",
      "type": "mediaFolder",
      "bulk": false,
      "output": "notification",
      "outputType": "text"
    }
  ],
  "frontMatter.taxonomy.fieldGroups": [
    {
      "id": "newsFigure",
      "labelField": "caption",
      "fields": [
        {
          "title": "Image",
          "name": "src",
          "type": "image",
          "required": true,
          "description": "Choose a public image; ordinary PNG/JPEG/WebP images are prepared automatically during the build."
        },
        {
          "title": "Alt text",
          "name": "alt",
          "type": "string",
          "required": true,
          "description": "Describe what the figure shows for someone who cannot see it; do not repeat the caption."
        },
        {
          "title": "Caption",
          "name": "caption",
          "type": "string",
          "required": true,
          "description": "One concise sentence explaining why the figure belongs with this update."
        },
        {
          "title": "Credit",
          "name": "credit",
          "type": "string",
          "required": true,
          "description": "Name the public paper/source or identify this as your original image."
        },
        {
          "title": "Public source link",
          "name": "sourceUrl",
          "type": "string",
          "single": true,
          "required": false,
          "description": "For a published figure, link to the DOI or canonical public source."
        }
      ]
    },
    {
      "id": "experienceAdvisor",
      "labelField": "name",
      "fields": [
        {
          "title": "Name",
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "title": "URL",
          "name": "url",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "id": "experienceAppointment",
      "labelField": "title",
      "fields": [
        {
          "title": "Period",
          "name": "period",
          "type": "string",
          "required": true,
          "description": "e.g. \"2023–present\"."
        },
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "title": "Institution",
          "name": "institution",
          "type": "string",
          "required": true
        },
        {
          "title": "Detail",
          "name": "detail",
          "type": "string",
          "single": false,
          "required": true
        },
        {
          "title": "Advisors",
          "name": "advisors",
          "type": "block",
          "fieldGroup": [
            "experienceAdvisor"
          ],
          "required": false,
          "description": "Optional."
        }
      ]
    },
    {
      "id": "experienceEducation",
      "labelField": "degree",
      "fields": [
        {
          "title": "Period",
          "name": "period",
          "type": "string",
          "required": true
        },
        {
          "title": "Degree",
          "name": "degree",
          "type": "string",
          "required": true
        },
        {
          "title": "Institution",
          "name": "institution",
          "type": "string",
          "required": true
        },
        {
          "title": "Detail",
          "name": "detail",
          "type": "string",
          "single": false,
          "required": true
        }
      ]
    },
    {
      "id": "experienceCapability",
      "labelField": "title",
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "title": "Items",
          "name": "items",
          "type": "list",
          "required": true
        }
      ]
    },
    {
      "id": "experiencePresentation",
      "labelField": "title",
      "fields": [
        {
          "title": "Year",
          "name": "year",
          "type": "number",
          "required": true
        },
        {
          "title": "Venue",
          "name": "venue",
          "type": "string",
          "required": true
        },
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "id": "experienceProvenance",
      "fields": [
        {
          "title": "Source (do not change)",
          "name": "source",
          "type": "string",
          "required": true,
          "description": "Fixed value: \"CV supplied privately by Hao Liu\". Changing this text breaks the build."
        },
        {
          "title": "Publication policy (do not change)",
          "name": "publicationPolicy",
          "type": "string",
          "required": true,
          "description": "Fixed value: \"Extracted factual information only; do not publish or link the CV\". Changing this text breaks the build."
        },
        {
          "title": "Last checked",
          "name": "sourceCheckedAt",
          "type": "datetime",
          "dateFormat": "yyyy-MM-dd",
          "required": true,
          "description": "Update whenever you reverify appointments, education, or presentations against the private CV."
        }
      ]
    }
  ],
  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "news",
      "pageBundle": false,
      "clearEmpty": true,
      "fields": [
        {
          "title": "Headline",
          "name": "title",
          "type": "string",
          "single": true,
          "required": true,
          "description": "A short, specific headline. It is also used to generate the filename."
        },
        {
          "title": "Date",
          "name": "date",
          "type": "datetime",
          "default": "{{now}}",
          "dateFormat": "yyyy-MM-dd",
          "isPublishDate": true,
          "required": true,
          "description": "Use the date of the public announcement or event."
        },
        {
          "title": "Draft (excluded from website and RSS)",
          "name": "draft",
          "type": "boolean",
          "default": true,
          "description": "Turn off only when the public update is approved for release. Drafts in a public repository are not private."
        },
        {
          "title": "One-sentence summary",
          "name": "summary",
          "type": "string",
          "required": true,
          "description": "Shown on the Home and News pages; keep it factual and understandable on its own."
        },
        {
          "title": "Related publication",
          "name": "publicationId",
          "type": "string",
          "required": false,
          "description": "Advanced local editing only: publication filename. Use Pages CMS to choose by title."
        },
        {
          "title": "Figures",
          "name": "figures",
          "type": "block",
          "fieldGroup": [
            "newsFigure"
          ],
          "required": false,
          "description": "Optional. Add a complete block for each figure; the first becomes the News listing thumbnail."
        }
      ]
    },
    {
      "name": "person",
      "pageBundle": false,
      "clearEmpty": true,
      "fields": [
        {
          "title": "Name",
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "title": "Degree",
          "name": "degree",
          "type": "string",
          "required": true,
          "description": "e.g. \"Ph.D.\""
        },
        {
          "title": "Role",
          "name": "role",
          "type": "string",
          "required": true
        },
        {
          "title": "Organizations",
          "name": "organizations",
          "type": "list",
          "required": true
        },
        {
          "title": "Location",
          "name": "location",
          "type": "string",
          "required": true
        },
        {
          "title": "Email",
          "name": "email",
          "type": "string",
          "required": true
        },
        {
          "title": "ORCID URL",
          "name": "orcid",
          "type": "string",
          "required": true
        },
        {
          "title": "Google Scholar URL",
          "name": "scholar",
          "type": "string",
          "required": true
        },
        {
          "title": "Biography paragraphs",
          "name": "bio",
          "type": "list",
          "required": true,
          "description": "1 to 4 short paragraphs, each its own list item."
        }
      ]
    },
    {
      "name": "experience",
      "pageBundle": false,
      "clearEmpty": true,
      "fields": [
        {
          "title": "Summary",
          "name": "summary",
          "type": "string",
          "single": false,
          "required": true
        },
        {
          "title": "Appointments",
          "name": "appointments",
          "type": "block",
          "fieldGroup": [
            "experienceAppointment"
          ],
          "required": true
        },
        {
          "title": "Education",
          "name": "education",
          "type": "block",
          "fieldGroup": [
            "experienceEducation"
          ],
          "required": true
        },
        {
          "title": "Capabilities",
          "name": "capabilities",
          "type": "block",
          "fieldGroup": [
            "experienceCapability"
          ],
          "required": true
        },
        {
          "title": "Presentations",
          "name": "presentations",
          "type": "block",
          "fieldGroup": [
            "experiencePresentation"
          ],
          "required": true,
          "description": "Newest first. Public events and finalized titles only."
        },
        {
          "title": "Provenance",
          "name": "provenance",
          "type": "fields",
          "fieldGroup": "experienceProvenance",
          "required": true
        }
      ]
    }
  ]
}
